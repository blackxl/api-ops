# =====================================================================
# api-ops production .env template
# Copy to .env on the server and fill every PLEASE_FILL_* value there.
# .env is gitignored. Do not commit real tokens, passwords, or hostnames.
# =====================================================================

# ===== Process =====
PORT=8088
GIN_MODE=release
LOG_LEVEL=info

# Host publish is 127.0.0.1:8088 (see docker-compose.prod.yml).
# The process inside the container still listens on :8088 so Docker can proxy it.
# Do not publish 0.0.0.0.

# ===== Local Postgres (the compose service named postgres) =====
# Required. Compose injects OPS_DB_DSN from this password.
# Use a long random value. Letters and digits only (no spaces).
OPS_PG_PASSWORD=PLEASE_FILL_OPS_PG_PASSWORD

# Leave this as a comment when using the bundled Postgres.
# Compose overrides OPS_DB_DSN for the api service.
# OPS_DB_DSN=host=postgres port=5432 user=api_ops password=PLEASE_FILL_OPS_PG_PASSWORD dbname=api_ops sslmode=disable TimeZone=Asia/Shanghai

# ===== Redis (compose service, no host port) =====
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Auth (required to boot) =====
# Generate in the panel terminal, then paste here. Never commit the result.
#   openssl rand -hex 32
OPS_API_TOKEN=PLEASE_FILL_OPS_API_TOKEN
JWT_SECRET=PLEASE_FILL_JWT_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=PLEASE_FILL_ADMIN_PASSWORD

# Browser origin for the BaoTa site. Comma-separated if you add more.
CORS_ALLOWED_ORIGINS=https://ops.58api.net

# ===== New API read-only database =====
# Set host to the private DNS name or container name you configure
# (for example the Postgres container on a Docker network you attach).
# Do not commit the real host, user, or password.
# Do not pin a fixed bridge address in this repository.
API_OPS_RO_DSN=host=PLEASE_FILL_NEWAPI_DB_HOST port=5432 user=PLEASE_FILL_RO_USER password=PLEASE_FILL_RO_PASSWORD dbname=PLEASE_FILL_DB sslmode=disable TimeZone=Asia/Shanghai

# ===== New API admin API =====
upstream_ADMIN_BASE_URL=https://PLEASE_FILL_NEWAPI_HTTP_HOST
API_OPS_ADMIN_TOKEN=PLEASE_FILL_ADMIN_TOKEN
API_OPS_ADMIN_USER_ID=1

# ===== Billing display =====
QUOTA_PER_UNIT=500000
USD_CNY_RATE=7.20
DISPLAY_CURRENCY=CNY
UPSTREAM_IMPORT_MAX_ROWS=50000
DAILY_STMT_CRON=0 2 * * *

# ===== Optional LLM / alerts (leave empty to disable) =====
upstream_LLM_BASE_URL=
API_OPS_LLM_API_KEY=
upstream_LLM_MODEL=claude-sonnet-4-5
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
